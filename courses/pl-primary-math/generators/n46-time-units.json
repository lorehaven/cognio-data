{
 "formatVersion": "1.0",
 "id": "n46-time-units",
 "levels": [
  {
   "level": 1,
   "vars": {
    "ms": "[0, 2]"
   }
  },
  {
   "level": 2,
   "vars": {
    "ms": "[1, 3]"
   }
  },
  {
   "level": 3,
   "vars": {
    "ms": "[0, 1, 2, 3]"
   }
  }
 ],
 "vars": [
  {
   "name": "md",
   "expr": "choice(ms)"
  },
  {
   "name": "x",
   "expr": "[randint(2, 12), 15 * randint(2, 24), randint(2, 30), 15 * randint(2, 40)][md]"
  },
  {
   "name": "names",
   "expr": "[['h', 'min'], ['min', 'h'], ['min', 's'], ['s', 'min']]"
  },
  {
   "name": "v",
   "expr": "[x * 60, x / 60, x * 60, x / 60][md]"
  },
  {
   "name": "from_u",
   "expr": "names[md][0]"
  },
  {
   "name": "to_u",
   "expr": "names[md][1]"
  }
 ],
 "constraints": [
  "denom(v) in divisors(100)"
 ],
 "selfCheck": [
  "md in [1, 3] or v / 60 == x"
 ],
 "minDistinct": 30,
 "task": {
  "kind": "quantity-input",
  "prompt": "Zamień @{x|dec} @{from_u} na @{to_u}.",
  "answer": {
   "type": "quantity",
   "value": {
    "$expr": "v"
   },
   "unit": {
    "$expr": "to_u"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "1 h = 60 min, 1 min = 60 s. Na mniejszą jednostkę mnożymy przez 60, na większą dzielimy przez 60."
   },
   {
    "kind": "compute",
    "text": "@{(fmt(x) + ' · 60 = ' + fmt(v) if md == 0 or md == 2 else fmt(x) + ' : 60 = ' + fmt(v))}"
   }
  ],
  "input": {
   "unit": {
    "$expr": "to_u"
   }
  },
  "errorRules": [
   {
    "id": "wrong_direction",
    "answer": {
     "type": "quantity",
     "value": {
      "$expr": "x / 60 if md == 0 or md == 2 else x * 60"
     },
     "unit": {
      "$expr": "to_u"
     }
    },
    "feedback": "Sprawdź kierunek: na mniejszą jednostkę mnożymy, na większą dzielimy.",
    "when": "denom(x / 60 if md == 0 or md == 2 else x * 60) in divisors(1000)"
   }
  ]
 }
}
