{
 "formatVersion": "1.0",
 "id": "ew-time-add",
 "levels": [
  {
   "level": 1,
   "vars": {
    "step": "60",
    "dmax": "3"
   }
  },
  {
   "level": 2,
   "vars": {
    "step": "30",
    "dmax": "4"
   }
  },
  {
   "level": 3,
   "vars": {
    "step": "15",
    "dmax": "8"
   }
  }
 ],
 "vars": [
  {
   "name": "start",
   "expr": "randint(6, 18) * 60 + randint(0, 1) * 30 * (1 if step < 60 else 0)"
  },
  {
   "name": "dur",
   "expr": "step * randint(1, dmax)"
  },
  {
   "name": "end",
   "expr": "start + dur"
  },
  {
   "name": "c",
   "expr": "choice([['Lekcja zaczyna się o ', ' i trwa ', 'O której się kończy?'], ['Film zaczyna się o ', ' i trwa ', 'O której się skończy?'], ['Wycieczka zaczyna się o ', ' i trwa ', 'O której się zakończy?']])"
  },
  {
   "name": "dtxt",
   "expr": "(str(dur // 60) + ' h') if dur % 60 == 0 else (str(dur) + ' min')"
  }
 ],
 "constraints": [
  "end < 1440"
 ],
 "minDistinct": 20,
 "task": {
  "kind": "time-input",
  "prompt": "@{c[0]}@{hhmm(start)}@{c[1]}@{dtxt}. @{c[2]}",
  "answer": {
   "type": "time",
   "value": {
    "$expr": "hhmm(end)"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "Dodaj czas trwania do godziny rozpoczęcia. 60 minut to 1 godzina."
   },
   {
    "kind": "compute",
    "text": "@{hhmm(start)} + @{dtxt} = @{hhmm(end)}"
   }
  ]
 }
}
