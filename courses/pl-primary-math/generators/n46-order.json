{
 "formatVersion": "1.0",
 "id": "n46-order",
 "levels": [
  {
   "level": 1,
   "vars": {
    "base_lo": "1000",
    "base_hi": "9000",
    "spread": "900"
   }
  },
  {
   "level": 2,
   "vars": {
    "base_lo": "100000",
    "base_hi": "900000",
    "spread": "90000"
   }
  },
  {
   "level": 3,
   "vars": {
    "base_lo": "1000000",
    "base_hi": "9000000",
    "spread": "900000"
   }
  }
 ],
 "vars": [
  {
   "name": "lo",
   "expr": "randint(base_lo, base_hi)"
  },
  {
   "name": "xs",
   "expr": "sample(lo, lo + spread, 5)"
  },
  {
   "name": "desc",
   "expr": "randint(0, 1) == 1"
  }
 ],
 "constraints": [
  "len(xs) == 5",
  "xs[0] != xs[1]",
  "xs[0] != xs[2]",
  "xs[0] != xs[3]",
  "xs[0] != xs[4]",
  "xs[1] != xs[2]",
  "xs[1] != xs[3]",
  "xs[1] != xs[4]",
  "xs[2] != xs[3]",
  "xs[2] != xs[4]",
  "xs[3] != xs[4]"
 ],
 "task": {
  "kind": "order-items",
  "prompt": "@{('Ułóż liczby od największej do najmniejszej.' if desc else 'Ułóż liczby od najmniejszej do największej.')}",
  "answer": {
   "type": "sequence",
   "value": {
    "$expr": "(reverse(sorted(xs)) if desc else sorted(xs))"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "Najpierw porównaj liczby cyframi od najwyższego rzędu, potem ustaw je po kolei."
   },
   {
    "kind": "conclude",
    "text": "Kolejność: @{(reverse(sorted(xs)) if desc else sorted(xs))|list:semi}"
   }
  ],
  "input": {
   "items": [
    {
     "id": {
      "$expr": "str(xs[0])"
     },
     "text": "@{xs[0]|int}"
    },
    {
     "id": {
      "$expr": "str(xs[1])"
     },
     "text": "@{xs[1]|int}"
    },
    {
     "id": {
      "$expr": "str(xs[2])"
     },
     "text": "@{xs[2]|int}"
    },
    {
     "id": {
      "$expr": "str(xs[3])"
     },
     "text": "@{xs[3]|int}"
    },
    {
     "id": {
      "$expr": "str(xs[4])"
     },
     "text": "@{xs[4]|int}"
    }
   ]
  }
 }
}
