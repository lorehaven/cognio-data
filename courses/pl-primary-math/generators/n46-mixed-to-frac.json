{
 "formatVersion": "1.0",
 "id": "n46-mixed-to-frac",
 "levels": [
  {
   "level": 1,
   "vars": {
    "dmax": "6"
   }
  },
  {
   "level": 2,
   "vars": {
    "dmax": "12"
   }
  }
 ],
 "vars": [
  {
   "name": "d",
   "expr": "randint(2, dmax)"
  },
  {
   "name": "w",
   "expr": "randint(1, 8)"
  },
  {
   "name": "r",
   "expr": "randint(1, d - 1)"
  },
  {
   "name": "n",
   "expr": "w * d + r"
  }
 ],
 "constraints": [
  "gcd(r, d) == 1"
 ],
 "minDistinct": 30,
 "task": {
  "kind": "fraction-input",
  "prompt": "Zapisz liczbę mieszaną $@{w}\\frac{@{r}}{@{d}}$ w postaci ułamka niewłaściwego.",
  "answer": {
   "type": "rational",
   "num": {
    "$expr": "n"
   },
   "den": {
    "$expr": "d"
   },
   "form": "any"
  },
  "steps": [
   {
    "kind": "idea",
    "text": "Mnożymy całości przez mianownik i dodajemy licznik: @{w} · @{d} + @{r}."
   },
   {
    "kind": "compute",
    "text": "@{w * d} + @{r} = @{n}, więc $\\frac{@{n}}{@{d}}$"
   }
  ],
  "errorRules": [
   {
    "id": "no_add",
    "answer": {
     "type": "rational",
     "num": {
      "$expr": "w * d"
     },
     "den": {
      "$expr": "d"
     },
     "form": "any"
    },
    "feedback": "Do iloczynu całości i mianownika dodaj jeszcze licznik."
   }
  ]
 }
}
