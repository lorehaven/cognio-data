{
 "formatVersion": "1.0",
 "id": "ew-unit-fraction-name",
 "levels": [
  {
   "level": 1,
   "vars": {
    "ds": "[2, 3, 4]"
   }
  },
  {
   "level": 2,
   "vars": {
    "ds": "[2, 3, 4, 5, 8]"
   }
  }
 ],
 "vars": [
  {
   "name": "pool",
   "expr": "[2, 3, 4, 5, 8]"
  },
  {
   "name": "d",
   "expr": "choice(ds)"
  },
  {
   "name": "idx",
   "expr": "index(pool, d)"
  },
  {
   "name": "names",
   "expr": "['połowa', 'jedna trzecia', 'jedna czwarta', 'jedna piąta', 'jedna ósma']"
  },
  {
   "name": "ts",
   "expr": "['$\\\\frac{1}{2}$', '$\\\\frac{1}{3}$', '$\\\\frac{1}{4}$', '$\\\\frac{1}{5}$', '$\\\\frac{1}{8}$']"
  },
  {
   "name": "shape",
   "expr": "choice(['Pizzę', 'Tabliczkę czekolady', 'Tort', 'Pasek papieru'])"
  },
  {
   "name": "eqp",
   "expr": "'równe' if d in [2, 3, 4] else 'równych'"
  }
 ],
 "constraints": [
  "(ts[idx]) != (ts[(idx + 1) % 5])",
  "(ts[idx]) != (ts[(idx + 2) % 5])",
  "(ts[idx]) != (ts[(idx + 3) % 5])",
  "(ts[(idx + 1) % 5]) != (ts[(idx + 2) % 5])",
  "(ts[(idx + 1) % 5]) != (ts[(idx + 3) % 5])",
  "(ts[(idx + 2) % 5]) != (ts[(idx + 3) % 5])"
 ],
 "minDistinct": 5,
 "task": {
  "kind": "multiple-choice",
  "prompt": "@{shape} podzielono na @{d} @{eqp} części. Jaką częścią całości jest jedna z tych części?",
  "answer": {
   "type": "choice",
   "value": {
    "$expr": "'a'"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "Całość podzielono na równe części. Jedna część z @{d} to ułamek o mianowniku @{d}."
   },
   {
    "kind": "conclude",
    "text": "@{names[idx]} = @{ts[idx]}"
   }
  ],
  "options": [
   {
    "id": "a",
    "text": "@{ts[idx]}",
    "correct": "true"
   },
   {
    "id": "b",
    "text": "@{ts[(idx + 1) % 5]}",
    "correct": "false"
   },
   {
    "id": "c",
    "text": "@{ts[(idx + 2) % 5]}",
    "correct": "false"
   },
   {
    "id": "d",
    "text": "@{ts[(idx + 3) % 5]}",
    "correct": "false"
   }
  ],
  "media": [
   {
    "type": "figure",
    "kind": "fraction-bar",
    "essential": false,
    "alt": "Figura podzielona na równe części, jedna zacieniowana.",
    "params": {
     "parts": {
      "$expr": "d"
     },
     "shaded": 1
    }
   }
  ]
 }
}
