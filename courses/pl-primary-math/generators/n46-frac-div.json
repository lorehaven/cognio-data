{
 "formatVersion": "1.0",
 "id": "n46-frac-div",
 "levels": [
  {
   "level": 1,
   "vars": {
    "kind": "0"
   }
  },
  {
   "level": 2,
   "vars": {
    "kind": "1"
   }
  },
  {
   "level": 3,
   "vars": {
    "kind": "2"
   }
  }
 ],
 "vars": [
  {
   "name": "b",
   "expr": "randint(3, 12)"
  },
  {
   "name": "a",
   "expr": "randint(1, b - 1)"
  },
  {
   "name": "d",
   "expr": "randint(3, 12)"
  },
  {
   "name": "c",
   "expr": "randint(1, d - 1)"
  },
  {
   "name": "n",
   "expr": "randint(2, 9)"
  },
  {
   "name": "w",
   "expr": "randint(1, 3)"
  },
  {
   "name": "x",
   "expr": "a / b"
  },
  {
   "name": "y",
   "expr": "n if kind == 0 else (c / d if kind == 1 else w + c / d)"
  },
  {
   "name": "r",
   "expr": "x / y"
  },
  {
   "name": "txt",
   "expr": "'$\\\\frac{' + str(a) + '}{' + str(b) + '} : ' + (str(n) if kind == 0 else ('\\\\frac{' + str(c) + '}{' + str(d) + '}' if kind == 1 else str(w) + '\\\\frac{' + str(c) + '}{' + str(d) + '}')) + '$'"
  }
 ],
 "constraints": [
  "denom(r) > 1",
  "gcd(a, b) == 1",
  "kind == 0 or gcd(c, d) == 1",
  "x != y"
 ],
 "minDistinct": 30,
 "task": {
  "kind": "fraction-input",
  "prompt": "Oblicz: @{txt}",
  "answer": {
   "type": "rational",
   "num": {
    "$expr": "numer(r)"
   },
   "den": {
    "$expr": "denom(r)"
   },
   "form": "lowest"
  },
  "steps": [
   {
    "kind": "idea",
    "text": "Dzielenie przez ułamek zamieniamy na mnożenie przez odwrotność: odwracamy dzielnik (liczbę zamieniamy na ułamek $\\frac{n}{1}$)."
   },
   {
    "kind": "conclude",
    "text": "Wynik: $\\frac{@{numer(r)}}{@{denom(r)}}$"
   }
  ],
  "errorRules": [
   {
    "id": "multiply_instead",
    "answer": {
     "type": "rational",
     "num": {
      "$expr": "numer(x * y)"
     },
     "den": {
      "$expr": "denom(x * y)"
     },
     "form": "any"
    },
    "feedback": "Przy dzieleniu odwracamy drugi ułamek (zamieniamy go na odwrotność), a potem mnożymy.",
    "when": "x * y != r"
   }
  ]
 }
}
