{
 "formatVersion": "1.0",
 "id": "n46-dec-shift",
 "levels": [
  {
   "level": 1,
   "vars": {
    "mode": "0"
   }
  },
  {
   "level": 2,
   "vars": {
    "mode": "1"
   }
  },
  {
   "level": 3,
   "vars": {
    "mode": "2"
   }
  }
 ],
 "vars": [
  {
   "name": "k",
   "expr": "randint(1, 3)"
  },
  {
   "name": "p",
   "expr": "pow(10, k)"
  },
  {
   "name": "md",
   "expr": "randint(0, 1) if mode == 2 else mode"
  },
  {
   "name": "places",
   "expr": "randint(1, 3)"
  },
  {
   "name": "x",
   "expr": "randint(11, 9999) / pow(10, places)"
  },
  {
   "name": "r",
   "expr": "x * p if md == 0 else x / p"
  }
 ],
 "constraints": [
  "denom(x) != 1"
 ],
 "minDistinct": 40,
 "task": {
  "kind": "decimal-input",
  "prompt": "Oblicz: $@{x|dec} @{('\\\\cdot' if md == 0 else ':')} @{p|int}$",
  "answer": {
   "type": "decimal",
   "value": {
    "$expr": "r"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "@{('Mnożenie przez ' + str(p) + ' przesuwa przecinek o ' + pln(k, ['miejsce', 'miejsca', 'miejsc']) + ' w prawo.' if md == 0 else 'Dzielenie przez ' + str(p) + ' przesuwa przecinek o ' + pln(k, ['miejsce', 'miejsca', 'miejsc']) + ' w lewo.')}"
   },
   {
    "kind": "conclude",
    "text": "@{r|dec}"
   }
  ],
  "errorRules": [
   {
    "id": "wrong_direction",
    "answer": {
     "type": "decimal",
     "value": {
      "$expr": "x / p if md == 0 else x * p"
     }
    },
    "feedback": "Mnożenie przesuwa przecinek w prawo, a dzielenie – w lewo."
   }
  ]
 }
}
