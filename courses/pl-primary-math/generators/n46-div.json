 ],
 "vars": [
  {
   "name": "b",
   "expr": "randint(blo, bhi)"
  },
  {
   "name": "q",
   "expr": "randint(qlo, qhi)"
  },
  {
   "name": "a",
   "expr": "b * q"
  }
 ],
 "selfCheck": [
  "q * b == a"
 ],
 "task": {
  "kind": "number-input",
  "prompt": "Oblicz: @{a|int} : @{b|int}",
  "answer": {
   "type": "int",
   "value": {
    "$expr": "q"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "Dzielenie sprawdzamy mnożeniem: wynik · dzielnik = dzielna."
   },
   {
    "kind": "compute",
    "text": "@{q|int} · @{b|int} = @{a|int}"
   }
  ],
  "errorRules": [
   {
    "id": "off_by_one",
    "answer": {
     "type": "int",
     "value": {
      "$expr": "q + 1"
     }
    },
    "feedback": "Sprawdź mnożeniem: wynik razy dzielnik powinien dać dzielną."
   },
   {
    "id": "digit_zero",
    "answer": {
     "type": "int",
     "value": {
      "$expr": "q * 10"
     }
    },
    "feedback": "Sprawdź, ile cyfr powinien mieć wynik (oszacuj)."
   }
  ]
 }
}
