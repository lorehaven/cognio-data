{
 "formatVersion": "1.0",
 "id": "vh-regular-angle",
 "levels": [
  {
   "level": 1,
   "vars": {
    "mode": "0"
   }
  },
  {
   "level": 2,
   "vars": {
    "mode": "1"
   }
  },
  {
   "level": 3,
   "vars": {
    "mode": "2"
   }
  }
 ],
 "vars": [
  {
   "name": "ns",
   "expr": "[3, 4, 5, 6, 8, 9, 10, 12, 15, 18, 20, 24, 30, 36]"
  },
  {
   "name": "n",
   "expr": "choice(ns)"
  },
  {
   "name": "inner",
   "expr": "180 - 360 // n"
  },
  {
   "name": "outer",
   "expr": "360 // n"
  },
  {
   "name": "txt",
   "expr": "('Oblicz miarę kąta wewnętrznego wielokąta foremnego o ' + str(n) + ' bokach.') if mode == 0 else (('Oblicz miarę kąta zewnętrznego wielokąta foremnego o ' + str(n) + ' bokach.') if mode == 1 else ('Kąt wewnętrzny wielokąta foremnego ma ' + str(inner) + '°. Ile boków ma ten wielokąt?'))"
  },
  {
   "name": "ans",
   "expr": "inner if mode == 0 else (outer if mode == 1 else n)"
  },
  {
   "name": "u",
   "expr": "'°' if mode < 2 else 'boków'"
  }
 ],
 "selfCheck": [
  "inner * n == 180 * (n - 2)"
 ],
 "minDistinct": 10,
 "task": {
  "kind": "quantity-input",
  "prompt": "@{txt}",
  "answer": {
   "type": "quantity",
   "value": {
    "$expr": "ans"
   },
   "unit": {
    "$expr": "u"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "@{('Suma kątów zewnętrznych każdego wielokąta wypukłego to 360°. W wielokącie foremnym wszystkie kąty są równe: kąt zewnętrzny = 360° : n, a wewnętrzny = 180° − kąt zewnętrzny.')}"
   },
   {
    "kind": "compute",
    "text": "360 : @{n} = @{outer}; 180 − @{outer} = @{inner}"
   }
  ],
  "input": {
   "unit": {
    "$expr": "u"
   }
  },
  "media": [
   {
    "type": "figure",
    "kind": "regular-polygon",
    "essential": false,
    "alt": "Wielokąt foremny.",
    "params": {
     "n": {
      "$expr": "n"
     },
     "angles": [
      {
       "i": 0,
       "text": "?",
       "show": {
        "$expr": "mode == 0"
       }
      }
     ]
    },
    "when": "mode < 2"
   }
  ]
 }
}
