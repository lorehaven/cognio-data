 "task": {
  "kind": "number-input",
  "prompt": "Oblicz: @{a|int} · @{b|int}",
  "answer": {
   "type": "int",
   "value": {
    "$expr": "a * b"
   }
  },
  "steps": [
   {
    "kind": "idea",
    "text": "Mnożymy przez każdą cyfrę drugiej liczby i dodajemy wyniki cząstkowe (pamiętaj o przesunięciu)."
   },
   {
    "kind": "compute",
    "text": "@{a|int} · @{b|int} = @{a * b|int}"
   }
  ],
  "errorRules": [
   {
    "id": "no_shift",
    "answer": {
     "type": "int",
     "value": {
      "$expr": "a * ((b % 10) + (b // 10))"
     }
    },
    "feedback": "Mnożąc przez cyfrę dziesiątek, przesuń wynik o jedno miejsce w lewo (dopisz zero).",
    "when": "b >= 10 and b < 100 and a * ((b % 10) + (b // 10)) != a * b"
   }
  ]
 }
