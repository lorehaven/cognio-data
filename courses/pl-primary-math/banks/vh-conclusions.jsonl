{"kind": "multiple-choice", "prompt": "Pole prostokąta wynosi 24 cm², a jeden bok 4 cm. Co wynika z tych danych?", "options": [{"id": "a", "text": "Drugi bok ma 6 cm.", "correct": true}, {"id": "b", "text": "Obwód wynosi 24 cm.", "correct": false}, {"id": "c", "text": "Prostokąt jest kwadratem.", "correct": false}, {"id": "d", "text": "Drugi bok ma 20 cm.", "correct": false}], "answer": {"type": "choice", "value": "a"}, "steps": [{"kind": "idea", "text": "Z pola P = a · b i znanej wartości a wynika b = P : a."}], "level": 1, "id": "bank/vh-conclusions/3", "skill": "vh-conclusions", "provenance": {"source": "bank-human", "verifiedBy": "human", "createdAt": "2026-10-18"}}
