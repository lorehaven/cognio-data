{"kind": "find-the-mistake", "prompt": "Kuba obliczał 25% z 80. W którym kroku jest błąd?", "input": {"lines": [{"id": "l1", "text": "25% to jedna czwarta całości."}, {"id": "l2", "text": "80 : 4 = 20."}, {"id": "l3", "text": "Zatem 25% z 80 to 20."}, {"id": "l4", "text": "Odpowiedź: 20."}]}, "options": [{"id": "l1", "text": "krok 1"}, {"id": "l2", "text": "krok 2"}, {"id": "l3", "text": "krok 3"}, {"id": "l4", "text": "krok 4"}, {"id": "none", "text": "Nie ma błędu"}], "answer": {"type": "choice", "value": "none"}, "steps": [{"kind": "check", "text": "Sprawdzenie: 20 · 4 = 80, a 20 to jedna czwarta z 80. Nie ma błędu."}], "level": 1, "tags": ["thinking"], "id": "bank/n46-find-mistake/5", "skill": "n46-find-mistake", "provenance": {"source": "bank-human", "verifiedBy": "human", "createdAt": "2026-10-18"}}
